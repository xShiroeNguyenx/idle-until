{
  "name": "idle-until",
  "version": "0.3.0",
  "description": "Run JavaScript only when it won’t hurt performance",
  "type": "module",
  "main": "./dist/idle-until.cjs",
  "module": "./dist/idle-until.mjs",
  "types": "./index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./index.d.ts",
        "default": "./dist/idle-until.mjs"
      },
      "require": {
        "types": "./index.d.cts",
        "default": "./dist/idle-until.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "index.d.ts",
    "index.d.cts",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node build.mjs",
    "test": "node test/behavior.test.mjs",
    "test:types": "tsc --noEmit --strict test/types-fixture.ts"
  },
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xShiroeNguyenx/idle-until.git"
  },
  "keywords": [
    "performance",
    "web-vitals",
    "idle",
    "lcp",
    "javascript"
  ],
  "author": "Nguyễn Sơn Khánh",
  "license": "MIT",
  "devDependencies": {
    "esbuild": "^0.27.2",
    "typescript": "^6.0.3"
  }
}
